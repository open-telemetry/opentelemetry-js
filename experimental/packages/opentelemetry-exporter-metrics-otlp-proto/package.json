{
  "name": "@opentelemetry/exporter-metrics-otlp-proto",
  "version": "0.300.0-development.1",
  "description": "OpenTelemetry Collector Metrics Exporter allows user to send collected metrics to the OpenTelemetry Collector using protobuf over HTTP",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "imports": {
    "#platform": {
      "otel": {
        "node": "./src/platform/node/index.ts",
        "default": "./src/platform/browser/index.ts"
      },
      "node": {
        "require": "./dist/platform/node/index.cjs",
        "default": "./dist/platform/node/index.mjs"
      },
      "require": "./dist/platform/browser/index.cjs",
      "default": "./dist/platform/browser/index.mjs"
    }
  },
  "repository": "open-telemetry/opentelemetry-js",
  "scripts": {
    "prepublishOnly": "npm run compile",
    "compile": "tsdown",
    "clean": "rimraf dist build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tdd": "npm run test -- --watch-extensions ts --watch",
    "test": "nyc mocha 'test/**/*.test.ts' --exclude 'test/browser/**/*.ts'",
    "test:browser": "karma start --single-run",
    "version": "node ../../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean",
    "peer-api-check": "node ../../../scripts/peer-api-check.mjs",
    "align-api-deps": "node ../../../scripts/align-api-deps.mjs"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "protobuf",
    "tracing",
    "profiling",
    "metrics",
    "stats"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "doc",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@opentelemetry/api": "1.10.0-development.1",
    "@opentelemetry/sdk-metrics": "3.0.0-development.1",
    "@types/mocha": "10.0.10",
    "@types/node": "18.19.130",
    "@types/sinon": "22.0.0",
    "@types/webpack-env": "1.18.8",
    "babel-loader": "10.1.1",
    "babel-plugin-istanbul": "8.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-mocha": "2.0.1",
    "karma-spec-reporter": "0.0.37",
    "karma-webpack": "5.0.1",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "sinon": "22.1.0",
    "ts-loader": "9.5.7",
    "typescript": "5.2.2",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0 || 1.10.0-development.1"
  },
  "dependencies": {
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0-development.1",
    "@opentelemetry/otlp-exporter-base": "0.300.0-development.1",
    "@opentelemetry/otlp-transformer": "0.300.0-development.1"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/experimental/packages/opentelemetry-exporter-metrics-otlp-proto",
  "sideEffects": false
}
