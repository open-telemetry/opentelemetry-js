{
  "name": "@opentelemetry/sdk-metrics",
  "version": "3.0.0-development.0",
  "description": "OpenTelemetry metrics SDK",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": "open-telemetry/opentelemetry-js",
  "scripts": {
    "prepublishOnly": "npm run compile",
    "compile": "tsdown",
    "clean": "rimraf dist build",
    "test": "nyc mocha 'test/**/*.test.ts'",
    "test:bench": "node test/performance/benchmark/internal-benchmarks.js && node test/performance/benchmark/public-benchmarks.js | tee .benchmark-results.txt",
    "test:browser": "karma start --single-run",
    "tdd": "npm run test -- --watch-extensions ts --watch",
    "tdd:browser": "karma start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean",
    "prewatch": "node ../../scripts/version-update.js",
    "peer-api-check": "node ../../scripts/peer-api-check.js",
    "align-api-deps": "node ../../scripts/align-api-deps.js"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "metrics",
    "stats",
    "profiling"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "doc",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "@types/mocha": "10.0.10",
    "@types/node": "18.19.130",
    "@types/sinon": "17.0.4",
    "babel-plugin-istanbul": "8.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-mocha": "2.0.1",
    "karma-spec-reporter": "0.0.36",
    "karma-webpack": "5.0.1",
    "mocha": "11.8.0",
    "nyc": "17.1.0",
    "sinon": "18.0.1",
    "ts-loader": "9.5.7",
    "typescript": "5.2.2",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <1.10.0"
  },
  "dependencies": {
    "@opentelemetry/core": "3.0.0-development.0",
    "@opentelemetry/resources": "3.0.0-development.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/packages/sdk-metrics",
  "sideEffects": false
}
