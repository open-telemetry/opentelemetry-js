{
  "name": "https-example",
  "private": true,
  "version": "0.211.0",
  "description": "Example of HTTPs integration with OpenTelemetry",
  "scripts": {
    "server": "cross-env OTEL_SERVICE_NAME=example-https-server node --import ./telemetry.mjs ./server.js",
    "client": "cross-env OTEL_SERVICE_NAME=example-https-client node --import ./telemetry.mjs ./client.js",
    "align-api-deps": "node ../../scripts/align-api-deps.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/open-telemetry/opentelemetry-js.git"
  },
  "keywords": [
    "opentelemetry",
    "https",
    "tracing"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js/issues"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@opentelemetry/exporter-zipkin": "3.0.0-development.0",
    "@opentelemetry/instrumentation": "0.300.0-development.0",
    "@opentelemetry/instrumentation-http": "0.300.0-development.0",
    "@opentelemetry/resources": "3.0.0-development.0",
    "@opentelemetry/sdk-trace": "3.0.0-development.0",
    "@opentelemetry/semantic-conventions": "^1.29.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/examples/https",
  "devDependencies": {
    "cross-env": "^10.0.0"
  }
}
