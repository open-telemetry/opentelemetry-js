{
  "analytics": false,
  "targetDefaults": {
    "compile": {
      "cache": true,
      "dependsOn": [
        "version",
        "^compile"
      ],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/test/**/*.ts",
        "{projectRoot}/**/*.proto",
        "{projectRoot}/package.json",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/tsdown.*.config.ts",
        "{workspaceRoot}/tsdown.config.ts",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "watch": {
      "dependsOn": [
        "compile"
      ]
    },
    "test": {
      "dependsOn": [
        "^compile"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^compile"
      ]
    },
    "test:webworker": {
      "dependsOn": [
        "^compile"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/test/**/*.ts"
      ]
    },
    "version": {
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/src/version.ts"
      ]
    }
  }
}
