{
  "name": "@opentelemetry/semantic-conventions",
  "version": "1.43.0",
  "description": "OpenTelemetry semantic conventions",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./incubating": {
      "require": {
        "types": "./dist/index-incubating.d.cts",
        "default": "./dist/index-incubating.cjs"
      },
      "default": {
        "types": "./dist/index-incubating.d.mts",
        "default": "./dist/index-incubating.mjs"
      }
    }
  },
  "repository": "open-telemetry/opentelemetry-js",
  "scripts": {
    "prepublishOnly": "npm run compile",
    "compile": "tsdown",
    "clean": "rimraf dist build",
    "version": "node ../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean",
    "peer-api-check": "node ../scripts/peer-api-check.mjs",
    "align-api-deps": "node ../scripts/align-api-deps.mjs"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "tracing",
    "attributes",
    "semantic conventions"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "doc",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "typescript": "5.2.2"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/semantic-conventions",
  "sideEffects": false
}
