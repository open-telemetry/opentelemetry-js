{
  "name": "example-dice-instrumented",
  "private": true,
  "version": "1.0.0",
  "description": "Instrumented dice example application",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "start": "tsc && node --import ./build/instrumentation.js build/app.js",
