{
  "name": "@opentelemetry/api-config",
  "version": "0.222.0",
  "description": "Public declarative configuration API for OpenTelemetry",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "repository": "open-telemetry/opentelemetry-js",
  "scripts": {
    "align-api-deps": "node ../../../scripts/align-api-deps.mjs",
    "build": "npm run compile",
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run compile",
    "prewatch": "node ../../../scripts/version-update.js",
    "test": "nyc mocha test/**/*.test.ts",
    "test:browser": "karma start --single-run",
    "version": "node ../../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "browser",
    "configuration",
    "monitoring"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=8.0.0"
  },
  "files": [
    "doc",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^8.10.66",
    "@types/sinon": "17.0.4",
    "@types/webpack-env": "1.18.8",
    "babel-plugin-istanbul": "8.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-mocha": "2.0.1",
    "karma-spec-reporter": "0.0.37",
    "karma-webpack": "5.0.1",
    "mocha": "11.8.0",
    "nyc": "17.1.0",
    "sinon": "18.0.1",
    "ts-loader": "9.5.7",
    "typescript": "5.2.2",
    "webpack": "5.108.4"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/experimental/packages/api-config",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
